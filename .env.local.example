# Toolfolio - Beispiel-Env. Kopiere nach .env.local und fuelle die Werte.
# NIEMALS .env.local committen (steht in .gitignore).

# --- Supabase (EU-Region) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nur serverseitig, niemals an den Client geben:
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (+ PayPal) - Zahlungen, nur Referenzen bei Toolfolio ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Resend - Transaktionsmails ---
RESEND_API_KEY=

# --- Plausible - cookielose Statistik (EU) ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Google OAuth (SSO) - via Supabase Auth Provider konfigurieren ---
# (Client-ID/Secret werden in Supabase hinterlegt, nicht hier)

# --- Anthropic / Claude-API - nur fuer anonyme Aggregate, serverseitig ---
ANTHROPIC_API_KEY=
